{
  "name": "music-festival-planner",
  "version": "0.2.0",
  "private": true,
  "description": "離線優先的音樂祭行程規劃 PWA：瀏覽時間表、排自己的行程、演出前提醒。",
  "repository": {
    "type": "git",
    "url": "https://github.com/littlechintw/Music-Festival-Timeline.git"
  },
  "homepage": "https://github.com/littlechintw/Music-Festival-Timeline#readme",
  "bugs": {
    "url": "https://github.com/littlechintw/Music-Festival-Timeline/issues"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "type": "module",
  "scripts": {
    "predev": "node scripts/build-festival-index.mjs",
    "dev": "vite",
    "prebuild": "node scripts/build-festival-index.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "build:festivals": "node scripts/build-festival-index.mjs",
    "validate:festivals": "node scripts/validate-festivals.mjs",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{js,vue,css}\"",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@material-symbols/svg-400": "0.48.3",
    "@material/web": "2.5.0",
    "jsqr": "^1.4.0",
    "pinia": "^4.1.0",
    "qrcode": "^1.5.4",
    "vue": "^3.5.45",
    "vue-router": "^5.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@material/material-color-utilities": "0.4.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "^3.3.14",
    "workbox-cacheable-response": "^7.4.1",
    "workbox-core": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  }
}
